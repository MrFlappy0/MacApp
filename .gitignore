# =============================================================================
# MLX for All - .gitignore
# =============================================================================

# Build artifacts
build/
.build/
DerivedData/

# Xcode
*.xcodeproj/
*.xcworkspace/
!*.xcodeproj/project.pbxproj
!*.xcworkspace/contents.xcworkspacedata
*.xcarchive
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3
*.xcuserstate
xcuserdata/
*.xcresult

# Swift Package Manager
Package.resolved
*.swiftmodule
.swiftpm/

# Application built
*.app

# DMG files (keep the latest in releases)
*.dmg

# Temporary files
temp/
tmp/
*.tmp
*.temp

# Logs
*.log

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Environment
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Node (if used for documentation)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Generated resources (build-time only)
build/**/*.icns

# Artifacts
artifacts/
releases/

# OS generated files
*.pem
*.key

# Test results
TestResults/
